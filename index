<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GO Odontologia Especializada · Santo André</title>
<meta name="description" content="GO Odontologia Especializada em Santo André: atendimento humanizado, especialistas e estrutura moderna. Agende sua avaliação pelo WhatsApp.">
<style>
@font-face{font-family:'Fraunces';font-weight:400;font-style:normal;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Fraunces';font-weight:500;font-style:normal;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Fraunces';font-weight:400;font-style:italic;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:400;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:500;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'DM Sans';font-weight:700;src:url(data:font/woff2;base64,) format('woff2')}
:root{
  --wine:#6B1720;--wine-d:#4A0F16;--wine-l:#8C2A33;
  --nude:#EFE6DC;--sand:#D8C7B5;--cream:#FAF7F3;--gold:#A8835F;
  --ink:#2A1E1C;--ink-60:rgba(42,30,28,.66);--line:rgba(42,30,28,.1);
  --r:18px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',system-ui,sans-serif;color:var(--ink);background:var(--cream);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1140px;margin:0 auto;padding:0 20px}
.serif{font-family:'Fraunces',Georgia,serif}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;font-weight:500;letter-spacing:-.02em;line-height:1.12}
h2{font-size:clamp(30px,4.6vw,46px)}
h2 em,h1 em{font-style:italic;color:var(--wine)}
.eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.eyebrow:before{content:"";width:28px;height:1px;background:var(--gold)}
.lead{font-size:17px;color:var(--ink-60);max-width:560px}
section{padding:96px 0}
.btn{white-space:nowrap;display:inline-flex;align-items:center;gap:10px;padding:15px 26px;border-radius:999px;font-weight:700;font-size:15px;transition:transform .2s,background .2s;cursor:pointer;border:none;font-family:inherit}
.btn:hover{transform:translateY(-2px)}
.btn-wine{background:var(--wine);color:#fff}.btn-wine:hover{background:var(--wine-d)}
.btn-ghost{border:1.5px solid var(--wine);color:var(--wine);background:transparent}
.btn svg{width:18px;height:18px}
.ph{background:#F6E7C9;border-radius:4px;padding:0 4px;color:#7a5a12;font-style:normal}

/* ribbon */
.ribbon{background:var(--ink);color:#F4E9DD;font-size:12.5px;text-align:center;padding:8px 16px}
.ribbon b{color:#F3C77B}

/* header */
header{position:sticky;top:0;z-index:50;background:rgba(250,247,243,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:74px}
.nav img{height:42px;width:auto}
.nav ul{display:flex;gap:30px;list-style:none;font-size:14.5px;font-weight:500}
.nav ul a{color:var(--ink-60);transition:color .2s}.nav ul a:hover{color:var(--wine)}
.nav .btn{padding:11px 20px;font-size:14px}
.burger{display:none;background:none;border:none;width:42px;height:42px;cursor:pointer}
.burger span{display:block;width:22px;height:2px;background:var(--ink);margin:5px auto;transition:.3s}

/* hero */
.hero{padding:56px 0 90px;position:relative;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(40px,6.2vw,68px);margin:6px 0 22px}
.hero .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.rating{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 16px 7px 8px;font-size:13.5px;font-weight:500}
.rating .score{background:var(--wine);color:#fff;border-radius:999px;padding:3px 10px;font-weight:700}
.stars{color:#E2A93B;letter-spacing:2px}
.hero-img{position:relative}
.hero-img .main{border-radius:200px 200px var(--r) var(--r);overflow:hidden;aspect-ratio:4/5}
.hero-img .main img{width:100%;height:100%;object-fit:cover}
.hero-img .float{position:absolute;left:-34px;bottom:44px;background:#fff;border-radius:16px;padding:16px 18px;box-shadow:0 18px 40px rgba(74,15,22,.14);display:flex;gap:12px;align-items:center;max-width:250px}
.hero-img .float .ic{width:42px;height:42px;border-radius:12px;background:var(--nude);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--wine)}
.hero-img .float b{display:block;font-size:14px}.hero-img .float small{font-size:12.5px;color:var(--ink-60)}
.blob{position:absolute;right:-180px;top:-120px;width:520px;height:520px;border-radius:50%;background:var(--nude);z-index:-1}

/* diferenciais */
.difs{background:var(--wine);color:#fff;padding:0}
.difs-grid{display:grid;grid-template-columns:repeat(4,1fr)}
.dif{padding:34px 26px;border-right:1px solid rgba(255,255,255,.12)}
.dif:last-child{border-right:none}
.dif svg{width:28px;height:28px;stroke:#F0D9C2;fill:none;stroke-width:1.6;margin-bottom:14px}
.dif h3{font-size:20px;margin-bottom:6px}
.dif p{font-size:14px;color:rgba(255,255,255,.72)}

/* sobre */
.about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:center}
.about-imgs{position:relative;padding-bottom:60px}
.about-imgs img{border-radius:var(--r);object-fit:cover}
.about-imgs .a1{width:78%;aspect-ratio:4/5}
.about-imgs .a2{position:absolute;right:0;bottom:0;width:52%;aspect-ratio:1;border:8px solid var(--cream)}
.about p{color:var(--ink-60);margin-top:16px}
.about .sign{margin-top:28px;display:flex;gap:28px;flex-wrap:wrap}
.about .sign div{border-left:2px solid var(--gold);padding-left:14px}
.about .sign b{font-family:'Fraunces',serif;font-size:30px;font-weight:500;display:block;line-height:1;color:var(--wine)}
.about .sign small{font-size:13px;color:var(--ink-60)}

/* especialidades */
.esp{background:var(--nude)}
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:46px;flex-wrap:wrap}
.esp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:#fff;border-radius:var(--r);padding:30px 26px;transition:transform .25s,box-shadow .25s;position:relative}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(74,15,22,.1)}
.card .num{font-family:'Fraunces',serif;font-size:14px;color:var(--gold);font-style:italic}
.card h3{font-size:23px;margin:10px 0 8px}
.card p{font-size:14.5px;color:var(--ink-60)}
.card .more{margin-top:18px;font-size:13.5px;font-weight:700;color:var(--wine);display:inline-flex;gap:6px;align-items:center}

/* estrutura */
.gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:240px;gap:14px}
.gal figure{position:relative;border-radius:var(--r);overflow:hidden}
.gal figure img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.gal figure:hover img{transform:scale(1.04)}
.gal figure.big{grid-column:span 2;grid-row:span 2}
.gal figure.tall{grid-row:span 2}
.gal figcaption{position:absolute;left:14px;bottom:14px;background:rgba(250,247,243,.94);border-radius:999px;padding:6px 14px;font-size:13px;font-weight:500}

/* resultados */
.res{background:var(--ink);color:#fff}
.res .lead{color:rgba(255,255,255,.65)}
.res h2 em{color:#E8C9A6}
.res-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.ba{border-radius:var(--r);overflow:hidden;background:rgba(255,255,255,.05);border:1px dashed rgba(255,255,255,.25)}
.ba .imgs{display:grid;grid-template-columns:1fr 1fr;aspect-ratio:16/10}
.ba .imgs div{display:flex;align-items:flex-end;justify-content:center;padding:12px;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.5);background:rgba(255,255,255,.04)}
.ba .imgs div+div{background:rgba(232,201,166,.1);border-left:1px dashed rgba(255,255,255,.2)}
.ba .cap{padding:16px 18px;font-size:14px}
.ba .cap small{display:block;color:rgba(255,255,255,.5);font-size:12.5px}

/* avaliações */
.rev-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:center}
.rev-score{background:#fff;border-radius:24px;padding:40px 34px;text-align:center;border:1px solid var(--line)}
.rev-score .big{font-family:'Fraunces',serif;font-size:92px;line-height:1;color:var(--wine)}
.rev-score .stars{font-size:26px;margin:8px 0}
.rev-score p{color:var(--ink-60);font-size:14.5px;margin-bottom:22px}
.shots{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.shot{border:1.5px dashed var(--sand);border-radius:var(--r);padding:22px 20px;background:#fff;min-height:150px;display:flex;flex-direction:column;justify-content:center;gap:8px}
.shot .stars{font-size:15px}
.shot span{font-size:13.5px;color:var(--ink-60)}
.shot.wide{grid-column:span 2}

/* contato */
.contact{background:var(--nude)}
.c-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.form{background:#fff;border-radius:24px;padding:34px 30px}
.form h3{font-size:28px;margin-bottom:6px}
.form p.s{font-size:14px;color:var(--ink-60);margin-bottom:22px}
.field{margin-bottom:14px}
.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;font-family:inherit;font-size:15px;padding:13px 15px;border-radius:12px;border:1.5px solid var(--line);background:var(--cream);color:var(--ink);outline:none;transition:border .2s}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--wine)}
.field textarea{resize:vertical;min-height:84px}
.form .btn{width:100%;justify-content:center;margin-top:6px}
.form .lgpd{font-size:11.5px;color:var(--ink-60);margin-top:12px;text-align:center}
.info{display:flex;flex-direction:column;gap:14px}
.info-item{background:#fff;border-radius:16px;padding:18px 20px;display:flex;gap:14px;align-items:flex-start}
.info-item .ic{width:42px;height:42px;border-radius:12px;background:var(--nude);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--wine)}
.info-item svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8}
.info-item b{display:block;font-size:14.5px}
.info-item span{font-size:14px;color:var(--ink-60)}
.map{border-radius:16px;overflow:hidden;flex:1;min-height:220px;background:#e9e1d8}
.map iframe{width:100%;height:100%;min-height:220px;border:0;display:block}

/* footer */
footer{background:var(--wine-d);color:rgba(255,255,255,.75);padding:56px 0 26px;font-size:14px}
.f-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}
footer img{height:54px;width:auto;margin-bottom:14px}
footer h4{color:#fff;font-size:13px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:14px}
footer ul{list-style:none;display:flex;flex-direction:column;gap:8px}
footer a:hover{color:#fff}
.f-bottom{border-top:1px solid rgba(255,255,255,.12);margin-top:40px;padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12.5px;color:rgba(255,255,255,.5)}
.f-bottom b{color:#fff}

/* whatsapp float */
.wa{position:fixed;right:20px;bottom:20px;z-index:60;width:60px;height:60px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 26px rgba(37,211,102,.4);transition:transform .2s}
.wa:hover{transform:scale(1.07)}
.wa svg{width:32px;height:32px;fill:#fff}

/* reveal */
.rv{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}

@media (max-width:900px){
  section{padding:70px 0}
  .nav ul,.nav .btn{display:none}
  .burger{display:block}
  .nav.open ul{display:flex;position:absolute;top:74px;left:0;right:0;flex-direction:column;background:var(--cream);padding:18px 20px 24px;gap:16px;border-bottom:1px solid var(--line);font-size:17px}
  .hero{padding:34px 0 64px}
  .hero-grid,.about-grid,.rev-grid,.c-grid{grid-template-columns:1fr;gap:40px}
  .hero-img{max-width:420px;margin:0 auto;width:100%}
  .hero-img .float{left:-6px}
  .difs-grid{grid-template-columns:1fr 1fr}
  .dif:nth-child(2){border-right:none}
  .dif:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.12)}
  .esp-grid,.res-grid{grid-template-columns:1fr}
  .gal{grid-template-columns:1fr 1fr;grid-auto-rows:170px}
  .gal figure.big{grid-column:span 2;grid-row:span 2}
  .gal figure.tall{grid-row:span 2}
  .f-grid{grid-template-columns:1fr;gap:28px}
}
@media (max-width:520px){
  .difs-grid{grid-template-columns:1fr}
  .dif{border-right:none;border-bottom:1px solid rgba(255,255,255,.12)}
  .shots{grid-template-columns:1fr}.shot.wide{grid-column:auto}
  .hero .actions .btn{flex:1 1 100%;justify-content:center}
}
</style>
</head>
